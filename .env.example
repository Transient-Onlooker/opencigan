NEIS_API_KEY=
SHUTTER_MAX_REQUESTS=600
SHUTTER_WINDOW_SECONDS=60
SHUTTER_COOLDOWN_SECONDS=30
SHUTTER_MAX_LOAD=8.0
OPENCIGAN_ANALYTICS_DB=./data/analytics.sqlite3
OPENCIGAN_ANALYTICS_SECRET=replace-with-at-least-32-random-characters
OPENCIGAN_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional Pi-only key for signed Cloudflare client IP attribution.
# Must match Worker secret PROXY_IP_SIGNING_KEY; use unique random >=32 bytes.
# Never commit a real value or expose it as a VITE_ browser variable.
# OPENCIGAN_PROXY_IP_SIGNING_KEY=
