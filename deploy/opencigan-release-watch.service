[Unit]
Description=Check verified pycomcigan fork releases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/opensigan-releases/current
EnvironmentFile=%h/.config/opencigan/release-watch.env
ExecStart=%h/opensigan-releases/current/.venv/bin/python -m deploy.watch_release --root %h/.local/share/opencigan/components/pycomcigan --release %h/opensigan-releases/current --school ${OPENCIGAN_RELEASE_TEST_SCHOOL}
Nice=10
