{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensigan-private-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "REPLACE_WITH_VPC_SERVICE_ID",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE",
      "namespace_id": "961301",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "GENERAL_RATE",
      "namespace_id": "961302",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
