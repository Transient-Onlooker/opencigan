{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensigan-private-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://opencigan.mcv.kr,http://opencigan.mcv.kr,https://transient-onlooker.github.io"
  },
  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "REPLACE_WITH_VPC_SERVICE_ID",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE",
      "namespace_id": "961301",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "GENERAL_RATE",
      "namespace_id": "961302",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "TIMETABLE_RATE",
      "namespace_id": "961303",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "CALENDAR_RATE",
      "namespace_id": "961304",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MEAL_RATE",
      "namespace_id": "961305",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "ADMIN_RATE",
      "namespace_id": "961306",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "WEBHOOK_RATE",
      "namespace_id": "961307",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SUGGESTION_RATE",
      "namespace_id": "961308",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
